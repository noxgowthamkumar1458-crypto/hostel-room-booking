<?php
include 'config.php';
requireLogin();

if ($_SESSION['role'] === 'admin') {
    header("Location: admin_dashboard.php");
    exit();
}

$student_id = $_SESSION['user_id'];

// Fetch this student's bookings
$stmt = $conn->prepare("
    SELECT b.id, b.booking_date, b.check_in_date, b.status, r.room_number, r.room_type, r.price_per_month
    FROM bookings b
    JOIN rooms r ON b.room_id = r.id
    WHERE b.student_id = ?
    ORDER BY b.created_at DESC
");
$stmt->bind_param("i", $student_id);
$stmt->execute();
$bookings = $stmt->get_result();
?>
