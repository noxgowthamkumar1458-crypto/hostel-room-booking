<?php
include 'config.php';
requireLogin();

if ($_SESSION['role'] === 'admin') {
    header("Location: admin_dashboard.php");
    exit();
}

$student_id = $_SESSION['user_id'];
$error = '';
$success = '';

// Handle booking submission
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $room_id = $_POST['room_id'];
    $check_in_date = $_POST['check_in_date'];
    $booking_date = date('Y-m-d');

    // Check room is still available
    $check = $conn->prepare("SELECT status FROM rooms WHERE id = ?");
    $check->bind_param("i", $room_id);
    $check->execute();
    $roomResult = $check->get_result()->fetch_assoc();

    if (!$roomResult || $roomResult['status'] !== 'Available') {
        $error = "Sorry, this room is no longer available.";
    } else {
        $stmt = $conn->prepare("INSERT INTO bookings (student_id, room_id, booking_date, check_in_date, status) VALUES (?, ?, ?, ?, 'Pending')");
        $stmt->bind_param("iiss", $student_id, $room_id, $booking_date, $check_in_date);

        if ($stmt->execute()) {
            $success = "Room booking request submitted! Await admin approval.";
        } else {
            $error = "Booking failed. Please try again.";
        }
        $stmt->close();
    }
    $check->close();
}

// Fetch available rooms
$rooms = $conn->query("SELECT * FROM rooms WHERE status = 'Available' ORDER BY room_number");
?>
