<?php
include 'config.php';
requireLogin();
requireAdmin();

// Approve or reject booking
if (isset($_GET['action']) && isset($_GET['id'])) {
    $id = $_GET['id'];
    $action = $_GET['action'];

    if ($action === 'approve') {
        // Get room_id for this booking
        $booking = $conn->query("SELECT room_id FROM bookings WHERE id = $id")->fetch_assoc();

        $stmt = $conn->prepare("UPDATE bookings SET status = 'Approved' WHERE id = ?");
        $stmt->bind_param("i", $id);
        $stmt->execute();
        $stmt->close();

        // Mark room as Full
        $stmt2 = $conn->prepare("UPDATE rooms SET status = 'Full' WHERE id = ?");
        $stmt2->bind_param("i", $booking['room_id']);
        $stmt2->execute();
        $stmt2->close();

    } elseif ($action === 'reject') {
        $stmt = $conn->prepare("UPDATE bookings SET status = 'Rejected' WHERE id = ?");
        $stmt->bind_param("i", $id);
        $stmt->execute();
        $stmt->close();
    }

    header("Location: manage_bookings.php");
    exit();
}

$bookings = $conn->query("
    SELECT b.id, b.booking_date, b.check_in_date, b.status,
           u.name AS student_name, u.email, u.phone,
           r.room_number, r.room_type
    FROM bookings b
    JOIN users u ON b.student_id = u.id
    JOIN rooms r ON b.room_id = r.id
    ORDER BY b.created_at DESC
");
?>
