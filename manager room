<?php
include 'config.php';
requireLogin();
requireAdmin();

$error = '';
$success = '';

// Add new room
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['add_room'])) {
    $room_number = trim($_POST['room_number']);
    $room_type = $_POST['room_type'];
    $capacity = $_POST['capacity'];
    $price = $_POST['price'];
    $description = trim($_POST['description']);

    $stmt = $conn->prepare("INSERT INTO rooms (room_number, room_type, capacity, price_per_month, description) VALUES (?, ?, ?, ?, ?)");
    $stmt->bind_param("ssids", $room_number, $room_type, $capacity, $price, $description);

    if ($stmt->execute()) {
        $success = "Room added successfully.";
    } else {
        $error = "Room number may already exist.";
    }
    $stmt->close();
}

// Delete room
if (isset($_GET['delete'])) {
    $id = $_GET['delete'];
    $stmt = $conn->prepare("DELETE FROM rooms WHERE id = ?");
    $stmt->bind_param("i", $id);
    $stmt->execute();
    $stmt->close();
    header("Location: manage_rooms.php");
    exit();
}

// Toggle status
if (isset($_GET['toggle'])) {
    $id = $_GET['toggle'];
    $room = $conn->query("SELECT status FROM rooms WHERE id = $id")->fetch_assoc();
    $newStatus = ($room['status'] === 'Available') ? 'Full' : 'Available';
    $stmt = $conn->prepare("UPDATE rooms SET status = ? WHERE id = ?");
    $stmt->bind_param("si", $newStatus, $id);
    $stmt->execute();
    $stmt->close();
    header("Location: manage_rooms.php");
    exit();
}

$rooms = $conn->query("SELECT * FROM rooms ORDER BY room_number");
?>
